#!/usr/bin/env python3
import json
import sys
from pathlib import Path

MINIMUM_PERCENT = 90
SOURCE_PREFIX = "src/first_commit/"
MAX_REPORT_BYTES = 16 * 1024 * 1024
COUNTS = ("covered_lines", "num_statements", "covered_branches", "num_branches")


class InvalidReportError(ValueError):
    pass


def _counts(entry: object) -> dict[str, int]:
    summary = entry.get("summary") if isinstance(entry, dict) else None
    if not isinstance(summary, dict):
        raise InvalidReportError
    counts: dict[str, int] = {}
    for name in COUNTS:
        value = summary.get(name)
        # bool is an int subclass; this script runs without the product, so it
        # cannot share first_commit.json_values.
        if type(value) is not int or value < 0:
            raise InvalidReportError
        counts[name] = value
    if (
        counts["covered_lines"] > counts["num_statements"]
        or counts["covered_branches"] > counts["num_branches"]
    ):
        raise InvalidReportError
    return counts


def _below(covered: int, total: int) -> bool:
    return total > 0 and covered * 100 < MINIMUM_PERCENT * total


def _failures(raw: bytes) -> list[str]:
    try:
        report = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise InvalidReportError from error
    files = report.get("files") if isinstance(report, dict) else None
    if not isinstance(files, dict):
        raise InvalidReportError
    checked = 0
    failures = []
    for path in sorted(files):
        if not isinstance(path, str) or not path.startswith(SOURCE_PREFIX):
            continue
        counts = _counts(files[path])
        checked += 1
        if _below(counts["covered_lines"], counts["num_statements"]):
            failures.append(f"{path} line coverage")
        if _below(counts["covered_branches"], counts["num_branches"]):
            failures.append(f"{path} branch coverage")
    if not checked:
        raise InvalidReportError
    return failures


def _report_bytes(path: Path) -> bytes:
    with path.open("rb") as stream:
        raw = stream.read(MAX_REPORT_BYTES + 1)
    if len(raw) > MAX_REPORT_BYTES:
        raise InvalidReportError
    return raw


def main(arguments: list[str]) -> int:
    if len(arguments) != 1:
        print("usage: scripts/check-coverage COVERAGE_JSON", file=sys.stderr)
        return 2
    try:
        failures = _failures(_report_bytes(Path(arguments[0])))
    except (OSError, InvalidReportError):
        print("error: coverage report is missing or invalid", file=sys.stderr)
        return 2
    for failure in failures:
        print(f"error: {failure} is below {MINIMUM_PERCENT}%", file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
